{
  "manifest_version": 3,
  "name": "DailyOverlay Context Bridge",
  "version": "0.2.0",
  "description": "Gửi tọa độ thumbnail YouTube và vùng lề trống Google Docs/Notion về DailyOverlay chạy local.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://docs.google.com/*",
        "*://*.notion.so/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
